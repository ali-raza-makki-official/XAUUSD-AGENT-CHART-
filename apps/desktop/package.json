{
  "name": "@aurum/desktop",
  "productName": "Aurum",
  "version": "0.1.0",
  "description": "AI-controlled XAUUSD trading workspace",
  "author": "Aurum",
  "homepage": "https://github.com/ali-raza-makki-official/XAUUSD-AGENT-CHART-",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:web": "vite --config vite.web.config.ts",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "pack": "electron-vite build && electron-builder --config electron-builder.config.cjs --dir",
    "dist:win": "electron-vite build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "verify:fuses": "node scripts/verify-fuses.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@aurum/core": "*",
    "@electron/fuses": "^2.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.61.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
