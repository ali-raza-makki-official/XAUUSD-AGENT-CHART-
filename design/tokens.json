{
  "$meta": { "name": "Aurum design tokens", "version": "0.1.0", "contrast": "all text tokens >= WCAG 2.2 AA on bg.panel" },
  "color": {
    "dark": {
      "bg": { "app": "#0E1013", "panel": "#14171B", "raised": "#1A1E23", "hover": "#20252B" },
      "border": { "subtle": "#262B32", "strong": "#333A43" },
      "text": { "primary": "#E6E9ED", "secondary": "#A3ABB5", "muted": "#7D8590" },
      "brand": { "gold": "#D4AF5A", "goldDim": "#8C7436", "onGold": "#14171B" },
      "ai": { "accent": "#7FA8F5", "dim": "#2C3E5E" },
      "trade": { "buy": "#2EBD85", "sell": "#F0616D" },
      "status": { "ok": "#2EBD85", "warn": "#E8903C", "error": "#F0616D", "stale": "#E8903C", "info": "#7FA8F5" }
    },
    "light": {
      "bg": { "app": "#F4F5F7", "panel": "#FFFFFF", "raised": "#F0F2F4", "hover": "#E8EBEE" },
      "border": { "subtle": "#DDE1E6", "strong": "#C5CBD3" },
      "text": { "primary": "#14171B", "secondary": "#4A525C", "muted": "#6B737D" },
      "brand": { "gold": "#8A6A1C", "goldDim": "#D9C48C", "onGold": "#FFFFFF" },
      "ai": { "accent": "#2F5FBF", "dim": "#DCE6F8" },
      "trade": { "buy": "#12805A", "sell": "#C23A47" }
    }
  },
  "radius": { "xs": "4px", "sm": "6px", "md": "10px", "lg": "14px", "pill": "999px" },
  "space": { "base": "4px", "scale": [0, 4, 8, 12, 16, 24, 32, 48] },
  "font": {
    "ui": "Inter, 'Segoe UI', system-ui, sans-serif",
    "mono": "'JetBrains Mono', 'Cascadia Mono', Consolas, monospace",
    "numeric": "tabular-nums",
    "size": { "xs": 11, "sm": 12, "md": 13, "lg": 15, "xl": 18, "2xl": 24 }
  },
  "layout": { "topbar": 40, "toolbar": 44, "chatMin": 320, "chatMax": 560, "bottomPanelCollapsed": 32 },
  "motion": { "fast": "120ms", "base": "180ms", "easing": "cubic-bezier(.2,.0,.0,1)", "respectReducedMotion": true },
  "chart": { "gridOpacity": 0.06, "candleUp": "#2EBD85", "candleDown": "#F0616D", "aiObject": "#7FA8F5", "manualObject": "#D4AF5A" }
}
